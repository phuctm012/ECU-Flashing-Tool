QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #1a1a1a;
}

QMainWindow, QDialog {
    background-color: #f4f6f9;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #d7dde5;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton:hover {
    background-color: #eef3fa;
    border-color: #4a7fd6;
}
QPushButton:pressed {
    background-color: #d9e6f7;
}

QPushButton#flashButton {
    background-color: #2b579a;
    color: white;
    font-weight: 600;
    font-size: 15px;
    border: none;
    border-radius: 8px;
}
QPushButton#flashButton:hover {
    background-color: #4a7fd6;
}

/* Batch Flash controls (gui/main_window.ui, Batch Flash section) —
   solid accent buttons like #flashButton, but a lower visual tier
   (base font-size/padding) since they're secondary to the main
   Start/Abort/Next button: red for "Stop Batch" (ends the batch
   session), green for "Export Report" (successful completion). */
QPushButton#buttonStopBatch {
    background-color: #b23b3b;
    color: white;
    border: none;
}
QPushButton#buttonStopBatch:hover {
    background-color: #d1574f;
}
QPushButton#buttonStopBatch:disabled {
    background-color: #ffffff;
    color: #9aa4b2;
    border: 1px solid #d7dde5;
}

QPushButton#buttonExportBatchReport {
    background-color: #3f8f5f;
    color: white;
    border: none;
}
QPushButton#buttonExportBatchReport:hover {
    background-color: #56b378;
}
QPushButton#buttonExportBatchReport:disabled {
    background-color: #ffffff;
    color: #9aa4b2;
    border: 1px solid #d7dde5;
}

/* Parallel Flash controls (gui/main_window.ui, Parallel Flash tab) —
   Start All mirrors #flashButton's blue "primary action" look;
   Abort All mirrors #buttonStopBatch's red "ends things" look. Each
   panel's own Flash/Abort button and progress bar are built at
   runtime instead (gui/parallel_flash.py) since their color has to
   switch dynamically with panel state — see that file's module
   docstring — so only these 2 fixed-color buttons and the View Log
   pill belong here. */
QPushButton#buttonParallelStartAll {
    background-color: #2b579a;
    color: white;
    font-weight: 600;
    border: none;
}
QPushButton#buttonParallelStartAll:hover {
    background-color: #4a7fd6;
}
QPushButton#buttonParallelStartAll:disabled {
    background-color: #ffffff;
    color: #9aa4b2;
    border: 1px solid #d7dde5;
}

QPushButton#buttonParallelAbortAll {
    background-color: #b23b3b;
    color: white;
    border: none;
}
QPushButton#buttonParallelAbortAll:hover {
    background-color: #d1574f;
}
QPushButton#buttonParallelAbortAll:disabled {
    background-color: #ffffff;
    color: #9aa4b2;
    border: 1px solid #d7dde5;
}

QPushButton#buttonParallelViewLog {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 10px;
    border: 1px solid #d7dde5;
    background: transparent;
    color: #5a6472;
}
QPushButton#buttonParallelViewLog:hover {
    border-color: #4a7fd6;
    color: #4a7fd6;
    background: transparent;
}

/* Test Connection / Save Report — same pill family as View Log/
   Settings above (4 secondary actions per channel panel). */
QPushButton#buttonParallelTestConnection {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 10px;
    border: 1px solid #d7dde5;
    background: transparent;
    color: #5a6472;
}
QPushButton#buttonParallelTestConnection:hover:!disabled {
    border-color: #4a7fd6;
    color: #4a7fd6;
    background: transparent;
}
QPushButton#buttonParallelTestConnection:disabled {
    color: #b7bec8;
    border-color: #e6e9ee;
}

QPushButton#buttonParallelSaveReport {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 10px;
    border: 1px solid #d7dde5;
    background: transparent;
    color: #5a6472;
}
QPushButton#buttonParallelSaveReport:hover {
    border-color: #4a7fd6;
    color: #4a7fd6;
    background: transparent;
}

/* Default (not-customized) look, matching #buttonParallelViewLog's
   pill shape — gui/parallel_flash.py's _apply_settings_button_style()
   overrides this with a filled accent look via setStyleSheet() once
   the channel has its own Basic Communication settings (see
   config.settings.HIGHLIGHT_BG_COLOR/ACCENT_COLOR), same as the
   Flash/Abort button and progress bar's dynamic per-state coloring. */
QPushButton#buttonParallelChannelSettings {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 10px;
    border: 1px solid #d7dde5;
    background: transparent;
    color: #5a6472;
}
QPushButton#buttonParallelChannelSettings:hover {
    border-color: #4a7fd6;
    color: #4a7fd6;
    background: transparent;
}

QTabWidget::pane {
    border: 1px solid #d7dde5;
    border-radius: 6px;
    top: -1px;
    background: #ffffff;
}
QTabBar::tab {
    background: #eaeef3;
    padding: 8px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    color: #5a6472;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #2b579a;
    font-weight: 600;
    border: 1px solid #d7dde5;
    border-bottom: none;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #e4e9f0;
    height: 18px;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 6px;
    background-color: #4a7fd6;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f7f9fb;
    gridline-color: #e9edf2;
    border: 1px solid #d7dde5;
    border-radius: 6px;
    selection-background-color: #eef3fa;
    selection-color: #1a1a1a;
}
QTableWidget::item {
    padding: 3px;
}
QHeaderView {
    background-color: #eef3fa;
}
QTableCornerButton::section {
    background-color: #eef3fa;
    border: none;
}
QHeaderView::section {
    background-color: #eef3fa;
    color: #2b579a;
    padding: 5px;
    border: none;
    border-bottom: 2px solid #4a7fd6;
    font-weight: 600;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d7dde5;
}
QMenuBar::item {
    padding: 5px 10px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #eef3fa;
    border-radius: 4px;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #d7dde5;
}
QMenu::item {
    padding: 6px 24px;
}
QMenu::item:selected {
    background-color: #4a7fd6;
    color: white;
}

QListWidget {
    background: #eaeef3;
    border: none;
    outline: none;
}
QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    margin: 2px 4px;
}
QListWidget::item:selected {
    background: #2b579a;
    color: white;
}

QLineEdit, QComboBox, QSpinBox {
    border: 1px solid #d7dde5;
    border-radius: 5px;
    padding: 4px 8px;
    background: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #4a7fd6;
}

/* Compression/Encryption Method (Configure > Data > Details
   table) — embedded via setCellWidget() alongside plain
   QTableWidgetItem rows like Start Address/Memory Size, so it
   blends flat into the table by default instead of always
   showing as a boxed input, matching those rows; a border only
   appears while actually being edited. */
QLineEdit#lineEditCompressionMethod, QLineEdit#lineEditEncryptionMethod {
    border: 1px solid transparent;
    background: transparent;
    padding: 3px;
}
QLineEdit#lineEditCompressionMethod:focus, QLineEdit#lineEditEncryptionMethod:focus {
    border: 1px solid #4a7fd6;
    border-radius: 5px;
    background: #ffffff;
}

QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #d7dde5;
    border-radius: 6px;
}

QLabel[sectionHeader="true"] {
    background-color: #E0E0E0;
    color: #1a1a1a;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #d7dde5;
}
